{
    admin off
    auto_https disable_redirects
    https_port 8443
}

http://:8080 {
    import /etc/caddy/routes.caddy
}

https://{$DEMO_HOSTNAME}:8443 {
    # OpenFrp must pass TLS through to 8443, including ACME's TLS-ALPN-01.
    # Only publish the URL after certificate validation succeeds externally.
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    import /etc/caddy/routes.caddy
}
