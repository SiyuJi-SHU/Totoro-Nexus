# Copy to .env. Keep real credentials private.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_RERANK_ENDPOINT=
# Set a private database password for a NEW installation; preserve it on upgrades.
PLATFORM_DB_PASSWORD=change-this-for-your-installation
APP_PORT=9900

# Keep this value when moving the existing installation. Never point two environments at it.
PLATFORM_DB_VOLUME=totoro-nexus-prod_platform-db-data
# Host directory containing volumes/{milvus,etcd,minio}.
DOCKER_VOLUME_DIRECTORY=./runtime
